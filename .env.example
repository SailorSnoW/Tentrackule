DISCORD_TOKEN=xxx
RIOT_API_KEY=xxx
DDRAGON_VERSION=16.1.1
DATABASE_URL=sqlite:tentrackule.db
POLLING_INTERVAL_SECS=60
RIOT_RATE_LIMIT_PER_SECOND=20
RUST_LOG=info,tentrackule=debug
# LOG_FORMAT=json  # Uncomment for production

# HTML→PNG renderer (Browserless). Leave unset for local dev: the bot then posts
# a text embed instead of a rendered card. In production these point at the
# private renderer app (see docs/renderer-deploy.md).
# RENDERER_URL=http://tentrackule-renderer.flycast:3000
# RENDERER_TOKEN=xxx
